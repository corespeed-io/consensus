{
  "name": "consensus-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "netlify dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "search": "tsx --env-file=.env scripts/search.ts",
    "v3": "tsx --env-file=.env scripts/v3.ts",
    "reddit:test": "tsx --env-file=.env scripts/reddit-test.ts",
    "web": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p web && vite build",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "audit": "tsx --env-file=.env scripts/audit.ts",
    "viewer:dev": "vite",
    "viewer:build": "node web/build-viewer.mjs",
    "test:skill": "node --test \"test/skill/*.test.mjs\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@netlify/blobs": "^10.7.13",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.309.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.1",
    "react-transition-group": "^4.4.5",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-transition-group": "^4.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
